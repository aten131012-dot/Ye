-- ===== ตัวช่วยจับคู่ชื่อ (แยก camelCase / ตัวเลข / สัญลักษณ์) =====
local function norm(n)
    n = tostring(n or "")
    n = n:gsub("(%l)(%u)", "%1 %2")
    n = n:gsub("(%a)(%d)", "%1 %2")
    n = n:gsub("[^%w]+", " ")
    return string.lower(n)
end
local function has(inst, keys)
    if not inst then return false end
    local sp = norm(inst.Name)
    local joined = sp:gsub(" ", "")
    local padded = " " .. sp .. " "
    for _, k in ipairs(keys) do
        local L = #k
        if L >= 6 then
            if string.find(joined, k, 1, true) then return true end
        else
            if string.find(padded, " " .. k .. " ", 1, true) then return true end
            if L == 5 then
                for t in sp:gmatch("%S+") do
                    if string.sub(t, 1, 5) == k then return true end
                end
            end
        end
    end
    return false
end
S.norm, S.has = norm, has

local function basePartOf(x)
    if not x then return nil end
    if x:IsA("BasePart") then return x end
    if x:IsA("Attachment") then return basePartOf(x.Parent) end
    if x:IsA("Model") then return x.PrimaryPart or x:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end
local function posOf(x)
    if not x then return nil end
    if x:IsA("BasePart") then return x.Position end
    if x:IsA("Model") then
        local ok, cf = pcall(function() return (x:GetBoundingBox()) end)
        if ok and cf then return cf.Position end
    end
    local sum, n = Vector3.zero, 0
    for _, d in ipairs(x:GetDescendants()) do
        if d:IsA("BasePart") then
            sum = sum + d.Position
            n = n + 1
            if n >= 300 then break end
        end
    end
    if n > 0 then return sum / n end
    return nil
end
