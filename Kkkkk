local function farmLoop(mode, my)
    local function alive() return runId == my end
    while runId == my and not NX.dead do
        local ok = true
        for i = 1, 10 do
            if runId ~= my then return end
            local p = stagePart(i)
            if not p then
                stopFarm()
                statusRow.set("⚠️ ไม่พบด่าน (ต้องอยู่ในแมพ Build A Boat)", "⚠️ Stage not found (join Build A Boat)")
                return
            end
            statusRow.set("กำลังลอย: ด่าน " .. i .. "/10", "Floating: stage " .. i .. "/10")
            if not NX.flyTo(p.Position, alive) then ok = false break end
            task.wait(0.15)
        end
        if runId ~= my then return end
        if ok then
            if mode == "chest" then
                local chest = chestPart()
                if chest then
                    statusRow.set("กำลังไปกล่องสมบัติ...", "Going to treasure chest...")
                    if NX.flyTo(chest.Position, alive) then
                        statusRow.set("เก็บกล่องแล้ว รอรีเซ็ต...", "Chest reached, waiting respawn...")
                        task.wait(3)
                    end
                end
                local c0 = player.Character
                local t = os.clock()
                while runId == my and player.Character == c0 and os.clock() - t < 45 do
                    local _, hum = getChar()
                    if hum and hum.Health <= 0 then break end
                    task.wait(0.4)
                end
                waitAlive(my)
            else
                stopFarm()
                statusRow.set("✓ ผ่านครบ 10 ด่านแล้ว", "✓ Finished all 10 stages")
                return
            end
        else
            waitAlive(my)
        end
    end
end

