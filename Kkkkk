local function pickBox()
    local hrp = NX.getChar()
    if not hrp then return nil end
    local best, bestScore, bestDist = nil, 0, math.huge
    iterWorld(function(d)
        if d:IsA("BasePart") or d:IsA("Model") then
            local n = string.lower(d.Name)
            local score = 0
            if string.find(n, "mystery", 1, true) or string.find(n, "questbox", 1, true) then
                score = 3
            elseif string.find(n, "box", 1, true) and not string.find(n, "hitbox", 1, true) then
                score = 1
            end
            local pos = score > 0 and posOf(d)
            if pos then
                if d:IsA("BasePart") and not d.Anchored then score += 1 end
                local dist = (pos - hrp.Position).Magnitude
                if (score >= 3 or dist < 300)
                    and (score > bestScore or (score == bestScore and dist < bestDist)) then
                    best, bestScore, bestDist = d, score, dist
                end
            end
        end
        return false
    end)
    return best
end

