function S.handShoot(tool, tgt, done, secs, dist)
    dist = dist or 12
    local t0, last = os.clock(), 0
    local ok = false
    while S.alive() and os.clock() - t0 < secs do
        if done() then ok = true break end
        if not tgt.Parent then break end
        local hrp = NX.getChar()
        if not hrp then break end
        if S.equip(tool) then
            local T = tgt.Position
            local P = T + S.openDir(T) * dist
            S.aim = T
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.lookAt(P, Vector3.new(T.X, P.Y, T.Z))
            if os.clock() - last >= 1 then
                last = os.clock()
                pcall(function() tool:Activate() end)
            end
        end
        task.wait(0.1)
    end
    S.aim = nil
    return ok or done()
end

-- หมุนบล็อกให้แกนท้องถิ่น f ชี้ไปทิศ d
local function aimCF(p, d, f)
    d = d.Unit
    local ref = (math.abs(d.Y) < 0.95) and Vector3.new(0, 1, 0) or Vector3.new(1, 0, 0)
    local a = d:Cross(ref).Unit
    local X, Y, Z
    if math.abs(f.X) > 0.5 then
        X = d * ((f.X >= 0) and 1 or -1)
        Y = a
        Z = X:Cross(Y)
    elseif math.abs(f.Y) > 0.5 then
        Y = d * ((f.Y >= 0) and 1 or -1)
        Z = a
        X = Y:Cross(Z)
    else
        Z = d * ((f.Z >= 0) and 1 or -1)
        X = a
        Y = Z:Cross(X)
    end
    return CFrame.fromMatrix(p, X, Y, Z)
end
local function snapAxis(v)
    local ax, ay, az = math.abs(v.X), math.abs(v.Y), math.abs(v.Z)
    if ax >= ay and ax >= az then return Vector3.new((v.X >= 0) and 1 or -1, 0, 0) end
    if ay >= az then return Vector3.new(0, (v.Y >= 0) and 1 or -1, 0) end
    return Vector3.new(0, 0, (v.Z >= 0) and 1 or -1)
end
-- รอดูกระสุนที่พุ่งออกมา (ไว้เรียนรู้ว่าปากกระบอกชี้แกนไหน)
local function probe(origin, secs)
    local ov = OverlapParams.new()
    local chr = player.Character
    local blocks = workspace:FindFirstChild("Blocks")
    local t0 = os.clock()
    while os.clock() - t0 < secs do
        local ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(origin, 45, ov) end)
        if ok then
            for _, p in ipairs(parts) do
                if not p.Anchored and p.AssemblyLinearVelocity.Magnitude > 25
                    and not (chr and p:IsDescendantOf(chr))
                    and not (blocks and p:IsDescendantOf(blocks))
                    and not Players:GetPlayerFromCharacter(p.Parent) then
                    return p
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
    return nil
end
-- สั่งให้ Cannon ยิง (คลิก/พรอมต์/รีโมทในโมเดล)
function S.fireBlock(m)
    local cd = m:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and fireclickdetector then
        pcall(function() cd.MaxActivationDistance = 1000 end)
        pcall(fireclickdetector, cd)
        return "click"
    end
    local pp = m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp and fireproximityprompt then
        pcall(fireproximityprompt, pp)
        return "prompt"
    end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            pcall(function() d:FireServer() end)
            return "remote:" .. d.Name
        end
    end
    return nil
end

function S.cannonShoot(name, tgt, done, secs)
    local T = tgt.Position
    local P = T + S.openDir(T) * 16
    local function body(m) return m:FindFirstChild("PPart") or m:FindFirstChildWhichIsA("BasePart", true) end
    local function place()
        local f = env.NX_MUZZLE or Vector3.new(0, 0, -1)
        local cf = aimCF(P, T - P, f)
        S.say("สร้าง " .. name .. " ตรงหน้าเป้าหมาย...", "Building " .. name .. " in front of the target...")
        local m, err = S.placeBlock(name, cf)
        if not m then return nil, err end
        local pp = body(m)
        if pp and (pp.Position - P).Magnitude > 12 then
            S.moveBlock(m, cf)
            task.wait(0.8)
            if (pp.Position - P).Magnitude > 12 then
                S.deleteBlock(m)
                return nil, "เซิร์ฟเวอร์ไม่ให้วางไกลขนาดนี้"
            end
        end
        return m
    end
    local m, err = place()
    if not m then
        S.say("⚠️ สร้าง Cannon ไม่สำเร็จ: " .. tostring(err), "⚠️ Cannon build failed: " .. tostring(err))
        return false
    end
    local t0, last, fired = os.clock(), 0, 0
    local calibrated = env.NX_MUZZLE ~= nil
    local ok = false
    while S.alive() and os.clock() - t0 < secs do
        if done() then ok = true break end
        if not m.Parent then
            m, err = place()
            if not m then break end
        end
        local hrp = NX.getChar()
        if hrp and (hrp.Position - P).Magnitude > 14 then
            NX.flyTo(P + Vector3.new(0, 3, 0), S.alive)
        end
        if os.clock() - last >= 5.4 then
            last = os.clock()
            local how = S.fireBlock(m)
            if not how then
                S.say("⚠️ Cannon ไม่มีปุ่มคลิก/รีโมทให้ยิง (กด 🔍 สแกนส่งข้อมูล)", "⚠️ cannon has nothing to fire (scan)")
                break
            end
            fired = fired + 1
            S.say("ยิง Cannon ครั้งที่ " .. fired .. " (" .. how .. ")", "Cannon shot #" .. fired .. " (" .. how .. ")")
            if not calibrated then
                local pp = body(m)
                local proj = pp and probe(pp.Position, 1.5)
                if proj then
                    calibrated = true
                    local axis = snapAxis(pp.CFrame:VectorToObjectSpace(proj.AssemblyLinearVelocity.Unit))
                    if axis ~= Vector3.new(0, 0, -1) then
                        env.NX_MUZZLE = axis
                        S.deleteBlock(m)
                        task.wait(0.7)
                        m, err = place()
                        if not m then break end
                        last = 0
                    else
                        env.NX_MUZZLE = axis
                    end
                end
            end
        end
        task.wait(0.2)
    end
    ok = ok or done()
    if m then S.deleteBlock(m) end
    return ok
end

-- ยิงเป้าด้วยอาวุธที่มี (Hand Cannon ก่อน ถ้าไม่มีใช้ Cannon ที่สร้างเอง)
function S.shoot(tgt, done, secs)
    local kind, obj = S.gunStatus()
    if kind == "hand" then
        S.say("ยิงด้วย Hand Cannon...", "Shooting with Hand Cannon...")
        return S.handShoot(obj, tgt, done, secs)
    elseif kind == "block" then
        return S.cannonShoot(obj, tgt, done, secs)
    end
    return false
end

