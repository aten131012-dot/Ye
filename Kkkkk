function NX.dropdown(page, order, labelKey, keys, default, cb)
    local box = make("Frame", {
        LayoutOrder = order, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, page)
    make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, box)
    local head = newRow(box, 1)
    head.Size = UDim2.new(1, 0, 0, 38)
    rowLabel(head, labelKey, -170)
    local hb = cuteButton({
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(150, 26), Text = "", TextSize = 11,
    }, head)
    round(hb, 8)
    local list = make("Frame", {
        LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = ROW, BorderSizePixel = 0, Visible = false,
    }, box)
    round(list, 10)
    stroke(list, Color3.fromRGB(90, 20, 36), 1)
    make("UIPadding", {
        PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5),
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
    }, list)
    make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)

    local cur = default
    local btns = {}
    local obj = {}
    local function paint()
        local t = TEXT[NX.lang]
        hb.Text = (t[cur] or cur) .. (list.Visible and "  ↑" or "  ↓")
        for k, b in pairs(btns) do
            b.Text = (k == cur and "✓ " or "") .. (t[k] or k)
        end
    end
    for i, k in ipairs(keys) do
        local b = cuteButton({
            LayoutOrder = i, Size = UDim2.new(1, 0, 0, 28), Text = "", TextSize = 11,
        }, list)
        round(b, 8)
        btns[k] = b
        b.Activated:Connect(function()
            cur = k
            list.Visible = false
            paint()
            if cb then task.spawn(cb, k) end
        end)
    end
    hb.Activated:Connect(function()
        list.Visible = not list.Visible
        paint()
    end)
    NX.refreshers[#NX.refreshers + 1] = paint
    function obj.get() return cur end
    paint()
    if cb then task.spawn(cb, cur) end
    return obj
end

