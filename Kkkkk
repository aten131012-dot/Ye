function S.placeBlock(name, worldCF)
    local _, rf = S.buildTool("BuildingTool")
    if not rf then return nil, "ไม่พบ BuildingTool/RF" end
    local zone = S.myZone()
    if not zone then return nil, "ไม่พบพื้นที่ทีม (Zone)" end
    local folder = S.myBlocks()
    if not folder then return nil, "ไม่พบ workspace.Blocks ของคุณ" end
    local have = S.inv(name)
    if have < 1 then return nil, "ไม่มี " .. name .. " ในคลัง" end
    local before = {}
    for _, m in ipairs(folder:GetChildren()) do before[m] = true end
    local rel = zone.CFrame:ToObjectSpace(worldCF)
    task.spawn(function()
        pcall(function() rf:InvokeServer(name, have, zone, rel, true) end)
    end)
    for _ = 1, 40 do
        for _, m in ipairs(folder:GetChildren()) do
            if not before[m] and m.Name == name then return m end
        end
        task.wait(0.1)
    end
    return nil, "เซิร์ฟเวอร์ไม่วางบล็อก (รีโมทอาจเปลี่ยน)"
end
