    return "pink"
end
local NAMECOL = { red = "red", orange = "orange", yellow = "yellow", green = "green", blue = "blue",
    purple = "purple", violet = "purple", pink = "pink", magenta = "pink", white = "white",
    black = "black", gray = "gray", grey = "gray", cyan = "blue" }
function S.colorOf(inst)
    local sp = norm(inst.Name)
    for t in sp:gmatch("%S+") do
        if NAMECOL[t] then return NAMECOL[t] end
    end
    local bp = basePartOf(inst)
    if bp then return S.colorName(bp.Color) end
    return nil
end

-- ===== หาด่าน =====
local function inOther(inst)
    local c = inst.Parent
    while c and c ~= workspace do
        if string.lower(c.Name) == "otherstages" then return true end
        c = c.Parent
    end
    return false
end
local function partCount(inst)
    local n = 0
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BasePart") then n = n + 1 end
        if n >= 2000 then break end
    end
    return n
end
function S.findStages(words)
    local out, seen = {}, {}
    local function consider(d)
        if (d:IsA("Model") or d:IsA("Folder")) and has(d, words) then
            local p = d.Parent
            while p and p ~= workspace do
                if seen[p] then return end
                p = p.Parent
            end
            seen[d] = true
            out[#out + 1] = d
        end
    end
    local bs = workspace:FindFirstChild("BoatStages")
    if bs then
        local n = 0
        for _, d in ipairs(bs:GetDescendants()) do
            n = n + 1
            if n % 4000 == 0 then task.wait() end
            consider(d)
            if #out >= 14 then break end
        end
    end
    if #out == 0 then
        iterWorld(function(d)
            consider(d)
            return #out >= 14
        end)
    end
    local ranked = {}
    for _, d in ipairs(out) do
        local cnt = partCount(d)
        if cnt > 0 then
            local act = not inOther(d)
            ranked[#ranked + 1] = { inst = d, active = act, n = cnt, score = (act and 100000 or 0) + cnt }
        end
    end
    table.sort(ranked, function(a, b) return a.score > b.score end)
    for _, r in ipairs(ranked) do r.pos = posOf(r.inst) end
    return ranked
end

function S.goStage(sec)
    S.say(sec.name .. ": กำลังหาด่าน...", sec.name .. ": locating stage...")
    local st = S.findStages(sec.words)[1]
    if not st or not st.pos then
        S.say("⚠️ " .. sec.name .. ": ไม่พบด่านในเซิร์ฟนี้ (ด่านอาจสุ่ม ลองเข้าเซิร์ฟใหม่ หรือกด 🔍 สแกน)",
            "⚠️ " .. sec.name .. ": stage not in this server (rejoin / scan)")
        return nil
    end
    S.say(sec.name .. ": บินไปที่ด่าน" .. (st.active and "" or " (OtherStages)"),
        sec.name .. ": flying to stage" .. (st.active and "" or " (OtherStages)"))
    if not NX.flyTo(st.pos + Vector3.new(0, 8, 0), S.alive) then return nil end
    task.wait(0.8)
    return st
end

-- กึ่งกลางทางน้ำที่ตำแหน่ง Z นั้น (ประมาณจาก DarknessPart ของด่านปกติ)
local function darkPos()
    local out = {}
    local ns = NX.normalStages and NX.normalStages()
    if ns then
        for i = 1, 10 do
            local st = ns:FindFirstChild("CaveStage" .. i)
            local dp = st and st:FindFirstChild("DarknessPart")
            if dp then out[#out + 1] = dp.Position end
        end
    end
    return out
end
function S.courseX(z)
    local best, bd
    for _, p in ipairs(darkPos()) do
        local d = math.abs(p.Z - z)
        if not bd or d < bd then best, bd = p, d end
    end
    return (best and best.X) or -51
end
-- ทิศ "ด้านโล่ง" จากเป้าหมายไปหากลางทางน้ำ
function S.openDir(T)
    local v = Vector3.new(S.courseX(T.Z) - T.X, 0, 0)
    if v.Magnitude < 8 then
        local hrp = NX.getChar()
        v = hrp and Vector3.new(hrp.Position.X - T.X, 0, hrp.Position.Z - T.Z) or Vector3.new(1, 0, 0)
        if v.Magnitude < 1 then v = Vector3.new(1, 0, 0) end
    end
    return v.Unit
end

-- ===== หาของที่กดได้ =====
S.CHEST = { "chest", "treasure", "secret", "reward", "loot", "trigger", "collect", "claim",
    "prize", "gift", "plush", "plushie", "doll", "teddy" }
local SKIP = { "kill", "lava", "dark", "spawn", "checkpoint", "water", "damage", "void" }

function S.interactables(root, words, ref)
    local info = {}
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
        n = n + 1
        if n % 3000 == 0 then task.wait() end
        local bp, kind
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            bp, kind = basePartOf(d.Parent), "act"
        elseif d:IsA("TouchTransmitter") then
            bp, kind = basePartOf(d.Parent), "touch"
        elseif d:IsA("BasePart") and words and has(d, words) then
            bp, kind = d, "name"
        end
        if bp then
            local e = info[bp]
            if not e then
                e = { act = false, touch = false, name = false }
                info[bp] = e
            end
            e[kind] = true
        end
    end
    local hrp = NX.getChar()
    local origin = ref or (hrp and hrp.Position) or Vector3.zero
    local list = {}
    for bp, e in pairs(info) do
        if not has(bp, SKIP) then
            local sc = (e.name and 100 or 0) + (e.act and 50 or 0) + (e.touch and 20 or 0)
            if words and not e.name and bp.Parent and bp.Parent:IsA("Model") and has(bp.Parent, words) then
                sc = sc + 60
            end
            list[#list + 1] = { p = bp, s = sc, d = (bp.Position - origin).Magnitude }
        end
    end
    table.sort(list, function(a, b)
        if a.s ~= b.s then return a.s > b.s end
        return a.d < b.d
    end)
    local out = {}
    for i = 1, math.min(#list, 40) do out[i] = list[i].p end
    return out
end

-- วัตถุ (Model/Part) ตามชื่อ เอาเฉพาะชั้นนอกสุด
function S.objs(root, words, max)
    local out, seen = {}, {}
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
        n = n + 1
        if n % 3000 == 0 then task.wait() end
        if (d:IsA("BasePart") or d:IsA("Model")) and has(d, words) then
            local p, skip = d.Parent, false
            while p and p ~= root do
                if seen[p] then skip = true break end
                p = p.Parent
            end
            if not skip then
                seen[d] = true
                out[#out + 1] = d
                if max and #out >= max then break end
            end
        end
    end
    return out
end

-- Part ที่ชื่อตรง ในรัศมีรอบจุด (ใช้ตอนไม่รู้ว่าอยู่ในโมเดลไหน)
function S.nearby(center, radius, words)
    local out, seen = {}, {}
    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(center, math.min(radius, 1800), OverlapParams.new())
    end)
    if ok then
        for _, p in ipairs(parts) do
            if not seen[p] and not Players:GetPlayerFromCharacter(p.Parent) then
                local m = p.Parent
                if has(p, words) or (m and m:IsA("Model") and has(m, words)) then
                    seen[p] = true
                    out[#out + 1] = p
                    if #out >= 60 then break end
                end
            end
        end
    end
    return out
end

function S.targets(root, words, prime, max)
    local out = {}
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
        n = n + 1
        if n % 3000 == 0 then task.wait() end
        if d:IsA("BasePart") and has(d, words) then
            local sz = d.Size
            local m = math.max(sz.X, sz.Y, sz.Z)
            local sc = (prime and has(d, prime)) and 100 or 0
            if m >= 3 and m <= 120 then sc = sc + 10 end
            if d.CanCollide then sc = sc + 5 end
            out[#out + 1] = { p = d, s = sc }
        end
    end
    table.sort(out, function(a, b) return a.s > b.s end)
    local res = {}
    for i = 1, math.min(max or 3, #out) do res[i] = out[i].p end
    return res
end

function S.changedFn(p)
    local b = { pos = p.Position, tr = p.Transparency, cc = p.CanCollide, sz = p.Size }
    return function()
        if not p.Parent then return true end
        if p.Transparency > b.tr + 0.5 then return true end
        if b.cc and not p.CanCollide then return true end
        if (p.Position - b.pos).Magnitude > 4 then return true end
        if (p.Size - b.sz).Magnitude > 2 then return true end
        return false
    end
end

-- ===== กด/แตะ/คลิก =====
local function hit(x)
    if x:IsA("ProximityPrompt") then
        pcall(function()
            x.HoldDuration = 0
            x.RequiresLineOfSight = false
            x.MaxActivationDistance = 60
        end)
        if fireproximityprompt then pcall(fireproximityprompt, x) end
    elseif x:IsA("ClickDetector") then
        pcall(function() x.MaxActivationDistance = 1000 end)
        if fireclickdetector then pcall(fireclickdetector, x) end
    elseif x:IsA("BasePart") then
        NX.touch(x)
    end
end
S.hit = hit

function S.activate(part)
    if not part or not part.Parent then return false end
    if not NX.flyTo(part.Position, S.alive) then return false end
    hit(part)
    local n = 0
    for _, x in ipairs(part:GetDescendants()) do
        n = n + 1
        if n > 30 then break end
        if x:IsA("ProximityPrompt") or x:IsA("ClickDetector") then hit(x) end
    end
    local par = part.Parent
    if par and par ~= workspace then
        for _, x in ipairs(par:GetChildren()) do
            if x:IsA("ProximityPrompt") or x:IsA("ClickDetector") then hit(x) end
        end
    end
    task.wait(0.35)
    return true
end

-- ===== ตรวจรางวัล (ดูค่าตัวเลขใน player.Data เพิ่มขึ้น) =====
local IGN = { "time", "played", "session", "ping", "fps", "tick", "stage", "streak", "login", "daily", "visit" }
local function ignored(name)
    name = string.lower(name)
    for _, k in ipairs(IGN) do
        if string.find(name, k, 1, true) then return true end
    end
    return false
end
function S.snap()
    local t = {}
    local d = player:FindFirstChild("Data")
    if d then
        for _, v in ipairs(d:GetChildren()) do
            if v:IsA("ValueBase") and type(v.Value) == "number" and not ignored(v.Name) then t[v] = v.Value end
        end
    end
    return t
end
function S.gained(before)
    local d = player:FindFirstChild("Data")
    if not d then return false end
    for _, v in ipairs(d:GetChildren()) do
        if v:IsA("ValueBase") and type(v.Value) == "number" and not ignored(v.Name) then
            local old = before[v]
            if old == nil then
                if v.Value > 0 then return true, v.Name end
            elseif v.Value > old then
                return true, v.Name
            end
        end
    end
    return false
end
function S.canDetect()
    local d = player:FindFirstChild("Data")
    return d ~= nil and #d:GetChildren() > 0
end
function S.inv(name)
    local d = player:FindFirstChild("Data")
    if not d then return 0 end
    local lk = string.lower(name)
    for _, v in ipairs(d:GetChildren()) do
        if v:IsA("ValueBase") and string.lower(v.Name) == lk and type(v.Value) == "number" then return v.Value end
    end
    return 0
end

function S.useList(list, before, label, maxN)
    local used = 0
    for i, p in ipairs(list) do
        if not S.alive() or i > (maxN or 25) then break end
        if p.Parent then
            S.say(label .. ": ใช้ " .. p.Name .. " (" .. i .. "/" .. #list .. ")",
                label .. ": using " .. p.Name .. " (" .. i .. "/" .. #list .. ")")
            if not S.activate(p) then break end
            used = used + 1
            task.wait(0.4)
            if before then
                local g, what = S.gained(before)
                if g then return true, used, what end
            end
        end
    end
    return false, used
end

function S.verdict(sec, got, used)
    if got then
        S.say("✓ " .. sec.name .. ": ได้รางวัลแล้ว", "✓ " .. sec.name .. ": reward received")
        return true
    end
    if (used or 0) > 0 and not S.canDetect() then
        S.say("✓ " .. sec.name .. ": ทำครบขั้นตอน (เช็ครางวัลไม่ได้)", "✓ " .. sec.name .. ": steps done (cannot verify)")
        return true
    end
    S.say("⚠️ " .. sec.name .. ": ทำแล้วแต่ไม่พบรางวัลเพิ่ม (อาจเคยรับแล้ว/ยังไม่ถูกจุด → กด 🔍 สแกน)",
        "⚠️ " .. sec.name .. ": no reward detected (claimed already / wrong spot → scan)")
    return false
end

