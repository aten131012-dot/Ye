-- ===== ตัวช่วยกด GUI ของเกม =====
local function norm(s)
    s = tostring(s or "")
    s = s:gsub("<[^>]->", "")
    s = s:gsub("%s+", "")
    return string.lower(s)
end

local function isShown(g)
    local cur = g
    while cur and cur ~= playerGui do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        if cur:IsA("CanvasGroup") and cur.GroupTransparency >= 0.99 then return false end
        cur = cur.Parent
    end
    return g.AbsoluteSize.X > 0 and g.AbsoluteSize.Y > 0
end

local function center(o) return o.AbsolutePosition + o.AbsoluteSize / 2 end
local function contains(o, p)
    local a, s = o.AbsolutePosition, o.AbsoluteSize
    return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local function findLabel(word, exactOnly)
    local best
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not d:IsDescendantOf(NX.gui) then
            local t = norm(d.Text)
            if t ~= "" then
                if t == word then
                    if isShown(d) then return d end
                elseif (not exactOnly) and (not best) and #t <= #word + 8
                    and string.find(t, word, 1, true) and isShown(d) then
                    best = d
                end
            end
        end
    end
    return best
end

local function buttonAt(label)
    if label:IsA("GuiButton") then return label end
    local root = label:FindFirstAncestorWhichIsA("LayerCollector") or playerGui
    local cam = workspace.CurrentCamera
    local maxArea = cam and (cam.ViewportSize.X * cam.ViewportSize.Y * 0.5) or math.huge
    local p = center(label)
    local best, bestArea, near, nearDist
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiButton") and not d:IsDescendantOf(NX.gui) and isShown(d) then
            local area = d.AbsoluteSize.X * d.AbsoluteSize.Y
            if area < maxArea then
                if contains(d, p) then
                    if not bestArea or area < bestArea then best, bestArea = d, area end
                else
                    local dist = (center(d) - p).Magnitude
                    if dist < 150 and (not nearDist or dist < nearDist) then near, nearDist = d, dist end
                end
            end
        end
    end
    return best or near
end

local function vimClick(o)
