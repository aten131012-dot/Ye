function NX.stepper(page, order, key, min, max, step, default, cb)
    local row = newRow(page, order)
    rowLabel(row, key, -140)
    local value = default
    local minus = cuteButton({
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0.5, 0),
        Size = UDim2.fromOffset(26, 26), Text = "-", TextSize = 16,
    }, row)
    round(minus, 8)
    local shown = make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -38, 0.5, 0),
        Size = UDim2.fromOffset(44, 26), BackgroundTransparency = 1, TextColor3 = WHITE,
        Font = Enum.Font.GothamBold, TextSize = 12, Text = tostring(value),
    }, row)
    local plus = cuteButton({
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(26, 26), Text = "+", TextSize = 16,
    }, row)
    round(plus, 8)
    local function setV(v)
        value = math.clamp(v, min, max)
        shown.Text = tostring(value)
        if cb then cb(value) end
    end
    minus.Activated:Connect(function() setV(value - step) end)
    plus.Activated:Connect(function() setV(value + step) end)
    if cb then cb(value) end
    return { set = setV, get = function() return value end }
