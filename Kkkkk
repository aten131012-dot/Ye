local farmSpeed = 120
function NX.flyTo(target, alive)
    while alive() and not NX.dead do
        local dt = RunService.Heartbeat:Wait()
        local hrp, hum = getChar()
        if not hrp or not hum or hum.Health <= 0 then return false end
        local d = target - hrp.Position
        local dist = d.Magnitude
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if dist < 3 then
            hrp.CFrame = CFrame.new(target) * (hrp.CFrame - hrp.CFrame.Position)
            return true
        end
        local stepLen = math.min(dist, farmSpeed * dt)
        hrp.CFrame = CFrame.new(hrp.Position + d.Unit * stepLen) * (hrp.CFrame - hrp.CFrame.Position)
    end
    return false
end

