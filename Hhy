    local function alive2() return alive() and not ctx.done and os.clock() - t0 < limit end
    local wasHidden = not questListShown()
    local errs = 0
    while alive2() do
        qStatus.set("กำลังทำเควส " .. pretty .. " (" .. math.floor(os.clock() - t0) .. "s)",
            "Doing " .. pretty .. " (" .. math.floor(os.clock() - t0) .. "s)")
        local ok, err = pcall(NX.objectivePass, name, ctx, alive2)
        if not ok then
            qStatus.set("⚠️ " .. tostring(err), "⚠️ " .. tostring(err))
            errs += 1
            if errs >= 3 then break end
        end
        task.wait(0.5)
        local shown = questListShown()
        if wasHidden and shown then break end
        if not shown then wasHidden = true end
    end
    if alive() then
        qStatus.set("ปิดเควส " .. pretty .. "...", "Ending " .. pretty .. "...")
        if openQuestList(alive) then
            local l2 = findLabel(name, true)
            if l2 then
                clickGui(l2)
                task.wait(0.6)
            end
            cancelActive()
        end
    end
    return true
end

