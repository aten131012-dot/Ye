local function dragonPass(ctx, alive)
    local sword = NX.heldSword()
    if not sword then
        NX.warnSword()
        task.wait(2)
        ctx.done = true
        return
    end
    local hrp = NX.getChar()
    if not hrp then return end

    if not ctx.launched then
        ctx.launched = true
        local l = findLabel("launch", true)
        if l then
            qStatus.set("Dragon: กด Launch ปลุกมังกร...", "Dragon: pressing Launch...")
            clickGui(l)
            task.wait(2.5)
        end
    end

    local dr = ctx.dragon
    if not (dr and dr.Parent) then
        dr = nil
        iterWorld(function(d)
            if (d:IsA("Model") or d:IsA("BasePart")) and string.find(string.lower(d.Name), "dragon", 1, true) then
                dr = d
                return true
            end
            return false
        end)
        ctx.dragon = dr
    end
    if not dr then
        ctx.miss = (ctx.miss or 0) + 1
        qStatus.set("Dragon: ไม่พบมังกร (กดปุ่ม 🔍 สแกน)", "Dragon: not found (press scan)")
        if ctx.miss >= 5 then ctx.done = true end
        task.wait(1.5)
        return
    end

    local function dead()
        if not dr.Parent then return true end
        local h = dr:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health <= 0
    end

    local handle = sword:FindFirstChild("Handle") or sword:FindFirstChildWhichIsA("BasePart")
    local parts = {}
    if dr:IsA("BasePart") then
        parts[1] = dr
    else
        for _, d in ipairs(dr:GetDescendants()) do
            if d:IsA("BasePart") then
                parts[#parts + 1] = d
                if #parts >= 8 then break end
            end
        end
    end

    qStatus.set("Dragon: บินไปหามังกร...", "Dragon: flying to the dragon...")
    if not NX.flyTo((posOf(dr) or hrp.Position) + Vector3.new(0, 4, 8), alive) then return end
    qStatus.set("Dragon: กำลังฟันมังกร...", "Dragon: slashing the dragon...")

    local t0 = os.clock()
    while alive() and not dead() and os.clock() - t0 < 12 do
        local h = NX.getChar()
        local p = posOf(dr)
        if not (h and p) then break end
        local tool = NX.heldSword()
        if not tool then
            NX.warnSword()
            ctx.done = true
            return
        end
        h.AssemblyLinearVelocity = Vector3.zero
        h.CFrame = CFrame.lookAt(p + Vector3.new(0, 4, 8), p)
        pcall(function() tool:Activate() end)
        if handle and handle.Parent and firetouchinterest then
            for _, part in ipairs(parts) do
                pcall(function()
                    firetouchinterest(handle, part, 0)
                    firetouchinterest(handle, part, 1)
                end)
            end
        end
        task.wait(0.12)
    end
    if dead() then
        qStatus.set("Dragon: ฆ่ามังกรแล้ว ✓", "Dragon: defeated ✓")
        task.wait(2)
        ctx.done = true
    end
end

