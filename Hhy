-- ===== แปลงค่าเป็น JSON / กลับ =====
local function enc(v, depth)
    if depth > 4 then return nil, "deep" end
    local t = typeof(v)
    if t == "nil" then
        return { t = "nil" }
    elseif t == "string" or t == "boolean" then
        return v
    elseif t == "number" then
        if v ~= v or v == math.huge or v == -math.huge then return nil, "num" end
        return v
    elseif t == "CFrame" then
        return { t = "CF", v = { v:GetComponents() } }
    elseif t == "Vector3" then
        return { t = "V3", v = { v.X, v.Y, v.Z } }
    elseif t == "Color3" then
        return { t = "C3", v = { v.R, v.G, v.B } }
    elseif t == "BrickColor" then
        return { t = "BC", v = v.Name }
    elseif t == "EnumItem" then
        return { t = "E", e = tostring(v.EnumType), n = v.Name }
    elseif t == "Instance" then
        if v == player then return { t = "LP" } end
        if player.Character and v == player.Character then return { t = "CH" } end
        local p = pathOf(v)
        if not p then return nil, "inst" end
        return { t = "I", p = p }
    elseif t == "table" then
        local list, cnt = {}, 0
        for k, val in pairs(v) do
            cnt += 1
            if cnt > 200 then return nil, "table" end
            local ek, e1 = enc(k, depth + 1)
            if e1 then return nil, e1 end
            local ev, e2 = enc(val, depth + 1)
            if e2 then return nil, e2 end
            list[#list + 1] = { ek, ev }
        end
        return { t = "T", p = list }
    end
    return nil, "type"
end

local function encArgs(args)
    local out = {}
    for i = 1, args.n do
        local e, err = enc(args[i], 0)
        if err then return nil, err end
        out[i] = e
    end
    return out
end

local function dec(e, delta)
    if type(e) ~= "table" then return e, true end
    local k = e.t
    if k == "nil" then
        return nil, true
    elseif k == "CF" then
        local cf = CFrame.new(table.unpack(e.v))
        if delta then cf = cf + delta end
        return cf, true
    elseif k == "V3" then
        return Vector3.new(e.v[1], e.v[2], e.v[3]), true
    elseif k == "C3" then
        return Color3.new(e.v[1], e.v[2], e.v[3]), true
    elseif k == "BC" then
        return BrickColor.new(e.v), true
    elseif k == "E" then
        local ok, item = pcall(function() return Enum[e.e][e.n] end)
        if ok and item then return item, true end
        return nil, false
    elseif k == "LP" then
        return player, true
    elseif k == "CH" then
        local c = player.Character
        return c, c ~= nil
    elseif k == "I" then
        local o = resolvePath(e.p)
        return o, o ~= nil
    elseif k == "T" then
        local out = {}
        for _, pr in ipairs(e.p) do
            local key, ok1 = dec(pr[1], delta)
            local val, ok2 = dec(pr[2], delta)
            if not (ok1 and ok2) then return nil, false end
            if key ~= nil then out[key] = val end
        end
        return out, true
    end
    return nil, false
end

-- ===== จับคำสั่งรีโมต =====
local rec = nil

local function toolPathOf(remote)
    local names = {}
    local p = remote
    while p and p ~= game do
        if p:IsA("Tool") then
            local rev = {}
            for i = #names, 1, -1 do rev[#rev + 1] = names[i] end
            return p.Name, rev
        end
        names[#names + 1] = p.Name
        p = p.Parent
    end
    return nil
end

local function capture(remote, method, args)
    local r = rec
    if not r or #r.calls >= 5000 then return end
    if typeof(remote) ~= "Instance" then return end
    if not (remote:IsA("RemoteFunction") or remote:IsA("RemoteEvent")) then return end
    local info
    local tn, sub = toolPathOf(remote)
    if tn then
        info = { tool = tn, sub = sub }
    elseif r.toolOnly then
        return
    else
        local p = pathOf(remote)
        if not p then return end
        info = { path = p }
    end
    local a = encArgs(args)
    if not a then
        r.skipped += 1
        return
    end
    r.calls[#r.calls + 1] = {
        r = info, m = method, a = a, n = args.n,
        t = math.floor((os.clock() - r.t0) * 1000) / 1000,
    }
    r.count = #r.calls
end

local function installHook()
    local state = env.NX_NC_STATE
    if not state then
        state = {}
        env.NX_NC_STATE = state
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local cb = state.cb
            if cb then
                local m = getnamecallmethod()
                if (m == "InvokeServer" or m == "FireServer") and not checkcaller() then
                    task.spawn(cb, self, m, table.pack(...))
                end
            end
            return old(self, ...)
        end))
    end
    state.cb = capture
end

