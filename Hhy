        if p and p:IsA("BasePart") then return p end
        if p and p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart") end
    end
    return nil
end

local function getItems(key)
    local out, seen = {}, {}
    local roots = NX.activeEvents[key]
