-- รายการไฟล์
local hdr = NX.status(page, 5)
hdr.set("📁 ไฟล์ที่บันทึกไว้ (กดเลือก)", "📁 Saved files (tap to select)")
local listBox = make("Frame", {
    LayoutOrder = 6, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    BackgroundTransparency = 1,
}, page)
make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, listBox)

function refreshList()
    for _, ch in ipairs(listBox:GetChildren()) do
        if ch:IsA("GuiObject") then ch:Destroy() end
    end
    local names = B.list()
    local found = false
    for i, n in ipairs(names) do
        if n == selected then found = true end
        local b = cuteButton({
            LayoutOrder = i, Size = UDim2.new(1, 0, 0, 30),
            Text = (n == selected and "✓ " or "") .. n, TextSize = 11,
        }, listBox)
        round(b, 8)
        b.Activated:Connect(function()
            selected = n
            refreshList()
        end)
    end
    if not found then selected = nil end
    if #names == 0 then
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, TextColor3 = C.WHITE,
            Font = Enum.Font.Gotham, TextSize = 11, Text = "(ยังไม่มีไฟล์ / no files)",
        }, listBox)
    end
end

NX.button(page, 7, "b_refresh", function() refreshList() end)

-- ปุ่มวาง/หยุด
local runId, playing = 0, false
local playBtn
local function paintPlay()
    labelRefs[playBtn] = playing and "b_stop" or "b_play"
    playBtn.Text = TEXT[NX.lang][labelRefs[playBtn]]
end
playBtn = NX.button(page, 8, "b_play", function()
    if playing then
        runId += 1
        playing = false
        paintPlay()
        status.set("■ หยุดแล้ว", "■ Stopped")
        return
    end
    if B.recording then
        status.set("⚠️ ปิดการบันทึกก่อน", "⚠️ Turn off recording first")
        return
    end
    if not selected then
        status.set("⚠️ กดเลือกไฟล์จากรายการก่อน", "⚠️ Pick a file from the list first")
        return
    end
    if NX.stopFarm then NX.stopFarm() end
    if NX.stopQuests then NX.stopQuests() end
    runId += 1
    local my = runId
    playing = true
    paintPlay()
    local name = selected
    task.spawn(function()
        local function alive() return runId == my and not NX.dead end
        local ok, a, s, total = B.play(name, delayMs / 1000, relT.get(), alive, function(i, tot, okc, skip)
            status.set("กำลังวาง: " .. i .. "/" .. tot .. " (ข้าม " .. skip .. ")",
                "Building: " .. i .. "/" .. tot .. " (skipped " .. skip .. ")")
        end)
        if runId == my then
            playing = false
            paintPlay()
            if ok then
                status.set("✓ เสร็จ: ส่ง " .. a .. " ข้าม " .. s .. " จาก " .. total,
                    "✓ Done: sent " .. a .. ", skipped " .. s .. " of " .. total)
            else
                status.set("⚠️ อ่านไฟล์ไม่ได้", "⚠️ Could not read file")
            end
        end
    end)
end)

NX.button(page, 9, "b_del", function()
    local nm = selected
    if not nm then
        status.set("⚠️ กดเลือกไฟล์ก่อน", "⚠️ Pick a file first")
        return
    end
    if B.delete(nm) then
        status.set("🗑️ ลบแล้ว: " .. nm, "🗑️ Deleted: " .. nm)
    else
        status.set("⚠️ ลบไม่ได้ (ตัวรันไม่รองรับ delfile)", "⚠️ Can't delete (no delfile)")
    end
    selected = nil
    refreshList()
end)

NX.stepper(page, 10, "b_delay", 20, 1000, 20, 120, function(v) delayMs = v end)
relT = NX.toggle(page, 11, "b_rel", false)

NX.cleanups[#NX.cleanups + 1] = function() runId += 1; playing = false end

refreshList()

