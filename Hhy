                    if not bestScore or score > bestScore then best, bestScore = d, score end
                end
            end
            return false
        end)
        ctx.ball = best
    end
    local ball = ctx.ball
    if ball and not (ctx.goal and ctx.goal.Parent) then
        local best, bestScore
        iterWorld(function(d)
            if d:IsA("BasePart") and d ~= ball then
                local n = string.lower(d.Name)
                local score = 0
                if string.find(n, "goal", 1, true) then
                    score = 2
                elseif n == "net" or string.find(n, "^net") then
                    score = 1
                end
                if score > 0 then
                    local s = score * 10000 - (d.Position - ball.Position).Magnitude
                    if not bestScore or s > bestScore then best, bestScore = d, s end
                end
            end
            return false
        end)
        ctx.goal = best
    end
    local goal = ctx.goal
    if not (ball and goal) then
        ctx.miss = (ctx.miss or 0) + 1
        qStatus.set("Soccer: ไม่พบบอล/โกล (กดปุ่ม 🔍 สแกน)", "Soccer: ball/goal not found (press scan)")
