    local n = 0
    local function consider(d)
        if seen[d] then return end
        local part = itemPart(d)
        if part and not isBad(part.Name) and not isBad(d.Name) then
            seen[d] = true
            out[#out + 1] = { part = part, obj = d }
        end
    end
    for _, r in ipairs(roots) do
        if r.Parent then
            consider(r)
            for _, d in ipairs(r:GetDescendants()) do
                n += 1
                if n % 2000 == 0 then task.wait() end
                consider(d)
                if #out >= 300 then return out end
            end
        end
    end
    return out
