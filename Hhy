local function cleanName(s)
    s = tostring(s or "")
    s = s:gsub("[/\\:%*%?\"<>|%c]", "")
    s = s:match("^%s*(.-)%s*$")
    return s
end

function B.save(name, r)
    if not ensureFolder() then return false, "file" end
    name = cleanName(name)
    if name == "" then name = "build_" .. os.date("%H%M%S") end
    local data = {
        v = 1, place = game.PlaceId,
        origin = { r.origin.X, r.origin.Y, r.origin.Z },
        calls = r.calls,
    }
    local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then return false, "json" end
    local ok2 = pcall(writefile, FOLDER .. "/" .. name .. ".json", json)
    if not ok2 then return false, "write" end
    return true, name
end

function B.list()
    local out = {}
    if not ensureFolder() then return out end
    local ok, files = pcall(listfiles, FOLDER)
    if ok and files then
        for _, f in ipairs(files) do
            local n = tostring(f):match("([^/\\]+)%.json$")
            if n then out[#out + 1] = n end
        end
    end
    table.sort(out)
    return out
end

local function loadFile(name)
    if not B.canFile then return nil end
    local path = FOLDER .. "/" .. name .. ".json"
    local ok, has = pcall(isfile, path)
    if not (ok and has) then return nil end
    local ok2, txt = pcall(readfile, path)
    if not ok2 then return nil end
    local ok3, data = pcall(HttpService.JSONDecode, HttpService, txt)
    if ok3 and type(data) == "table" and type(data.calls) == "table" then return data end
    return nil
end

function B.delete(name)
    if not (B.canFile and delfile) then return false end
    return (pcall(delfile, FOLDER .. "/" .. name .. ".json"))
end

-- ===== วางตามไฟล์ =====
local function findTool(name)
    local c = player.Character
    local t = c and c:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
    local bp = player:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
    return nil
end

local function resolveRemote(info)
    if info.tool then
        local tool = findTool(info.tool)
        if not tool then return nil end
        local o = tool
        for _, n in ipairs(info.sub or {}) do
            o = o and o:FindFirstChild(n)
        end
        return o, tool
    end
    return resolvePath(info.path or {}), nil
end

function B.play(name, delay, relative, alive, progress)
    local data = loadFile(name)
    if not data then return false, "load" end
    local calls = data.calls
    local delta
    if relative and data.origin then
        local hrp = NX.getChar()
        if hrp then
            delta = hrp.Position - Vector3.new(data.origin[1], data.origin[2], data.origin[3])
        end
    end
    local okc, skip, total = 0, 0, #calls
    for i, c in ipairs(calls) do
        if not alive() then break end
        local n = c.n or #c.a
        local remote, tool = resolveRemote(c.r)
        local args, good = {}, remote ~= nil
        if good then
            for j = 1, n do
                local v, ok = dec(c.a[j], delta)
                if not ok then good = false break end
                args[j] = v
            end
        end
        if good then
            if tool then
                local ch = player.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if hum and tool.Parent ~= ch then
                    pcall(function() hum:EquipTool(tool) end)
                    task.wait(0.2)
                end
            end
            local done = false
            task.spawn(function()
                pcall(function()
                    if c.m == "InvokeServer" then
                        remote:InvokeServer(table.unpack(args, 1, n))
                    else
                        remote:FireServer(table.unpack(args, 1, n))
                    end
                end)
                done = true
            end)
            local t0 = os.clock()
            while not done and os.clock() - t0 < 3 and alive() do task.wait() end
            okc += 1
        else
            skip += 1
        end
        if progress then progress(i, total, okc, skip) end
        task.wait(delay)
    end
    return true, okc, skip, total
end

