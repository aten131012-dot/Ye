local function collectLoop(key, my)
    local st = states[key]
    local function alive()
        return st.run == my and st.collect and not NX.dead and NX.activeEvents[key] ~= nil
    end
    while alive() do
        local hrp, hum = NX.getChar()
        if hrp and hum and hum.Health > 0 then
            local items = getItems(key)
            if #items == 0 then
                st.status.set("ไม่พบของให้เก็บ (รอ...)", "No items found (waiting...)")
                task.wait(2)
            else
                table.sort(items, function(a, b)
                    return (a.part.Position - hrp.Position).Magnitude
                        < (b.part.Position - hrp.Position).Magnitude
                end)
                local got = 0
                for _, it in ipairs(items) do
                    if not alive() then break end
                    local part = it.part
                    if part and part.Parent then
                        local h = NX.getChar()
                        if h then
                            local ok = true
                            if (part.Position - h.Position).Magnitude > 35 then
                                if st.far then
                                    ok = NX.flyTo(part.Position + Vector3.new(0, 3, 0), alive)
                                else
                                    ok = false
                                end
                            end
                            if ok then
                                interact(it)
                                got += 1
                                st.status.set("กำลังเก็บ: " .. got .. "/" .. #items,
                                    "Collecting: " .. got .. "/" .. #items)
                                task.wait(0.15)
                            end
                        end
                    end
                end
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end

local function nearLoop(key, my)
    local st = states[key]
    while st.nearRun == my and st.near and not NX.dead do
        local hrp = NX.getChar()
        if hrp then
            for _, it in ipairs(getItems(key)) do
                if st.nearRun ~= my then break end
                if it.part.Parent and (it.part.Position - hrp.Position).Magnitude <= 30 then
                    interact(it)
                end
            end
        end
        task.wait(0.6)
    end
end

local function espLoop(key, my)
    local st = states[key]
    local boxes, cnt = {}, 0
    while st.espRun == my and st.esp and not NX.dead do
        local want = {}
        for _, it in ipairs(getItems(key)) do
            local p = it.part
            if p.Parent then
                want[p] = true
                if not boxes[p] and cnt < 80 then
                    boxes[p] = make("SelectionBox", {
                        Adornee = p, Color3 = Color3.fromRGB(255, 170, 40),
                        LineThickness = 0.05, SurfaceTransparency = 0.75,
                        SurfaceColor3 = Color3.fromRGB(255, 170, 40),
                    }, NX.gui)
                    cnt += 1
                end
            end
        end
        for p, b in pairs(boxes) do
            if not want[p] then
                pcall(function() b:Destroy() end)
                boxes[p] = nil
                cnt -= 1
            end
        end
        task.wait(2)
    end
