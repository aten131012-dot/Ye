        for _, w in ipairs(words) do
            if string.find(s, w, 1, true) then return true end
        end
        return false
    end
    local out = { "== NEXORA EVENT DUMP == " .. key .. " | place " .. tostring(game.PlaceId) }
    out[#out + 1] = "-- ROOTS --"
    for i, r in ipairs(NX.activeEvents[key] or {}) do
        if i > 40 then break end
        out[#out + 1] = r.ClassName .. " | " .. r:GetFullName()
    end
    out[#out + 1] = "-- ITEMS --"
    for i, it in ipairs(getItems(key)) do
        if i > 60 then break end
        local p = it.part.Position
        out[#out + 1] = it.obj.ClassName .. " | " .. it.obj:GetFullName()
            .. " | " .. math.floor(p.X) .. "," .. math.floor(p.Y) .. "," .. math.floor(p.Z)
    end
    out[#out + 1] = "-- GUI --"
    local g = 0
    for _, d in ipairs(player:WaitForChild("PlayerGui"):GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not d:IsDescendantOf(NX.gui)
            and NX.g.isShown(d) and match(d.Text) then
            g += 1
            if g > 40 then break end
            out[#out + 1] = d.ClassName .. " | " .. d:GetFullName() .. " | '" .. d.Text .. "'"
        end
    end
    out[#out + 1] = "-- REMOTES --"
    local r = 0
    for _, d in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and match(d.Name) then
            r += 1
            if r > 40 then break end
            out[#out + 1] = d.ClassName .. " | " .. d:GetFullName()
        end
    end
    local text = table.concat(out, "\n")
    print(text)
    local clip = setclipboard or toclipboard
    local ok = clip and pcall(clip, text)
    if ok then
        st.status.set("✓ สแกนแล้ว คัดลอกไว้ (" .. #out .. " บรรทัด)", "✓ Scanned & copied (" .. #out .. " lines)")
